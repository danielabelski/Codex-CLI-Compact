#!/usr/bin/env bash
# graperoot — Dual-Graph launcher with AI tool selection
#
# Usage:
#   graperoot [path] --claude       # Claude Code  (same as dgc)
#   graperoot [path] --codex        # OpenAI Codex (same as dg)
#   graperoot [path] --cursor       # Cursor IDE
#   graperoot [path] --gemini       # Google Gemini CLI
#   graperoot [path] --antigravity  # Google Antigravity
#   graperoot [path] --openclaw     # OpenClaw
#   graperoot                       # Interactive tool picker
#   graperoot --version             # Print version
#   graperoot --update              # Force self-update
#
# The tool flag can come before or after the path.
# Flags can be written with or without --  (e.g. cursor or --cursor).
# Default: interactive picker.  Default path: current directory.
#
# Examples:
#   graperoot /path/to/project --claude
#   graperoot /path/to/project --cursor
#   graperoot /path/to/project gemini
#   graperoot . --codex
#   graperoot /path/to/project --claude --resume <session-id>
#   graperoot                          # interactive picker

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Version ───────────────────────────────────────────────────────────────────
_show_version() {
  local ver
  ver="$(cat "$SCRIPT_DIR/version.txt" 2>/dev/null || echo "unknown")"
  echo "graperoot $ver"
  exit 0
}

# ── Help ──────────────────────────────────────────────────────────────────────
_show_help() {
  cat <<'HELP'

  graperoot — Dual-Graph AI tool launcher

  Usage:
    graperoot [path] <tool> [options]
    graperoot [path]                   Interactive tool picker
    graperoot --update                 Force self-update
    graperoot --version                Print version

  Tools:
    --claude       Claude Code   (shorthand: dgc [path])
    --codex        OpenAI Codex  (shorthand: dg  [path])
    --cursor       Cursor IDE
    --gemini       Google Gemini CLI
    --opencode     OpenCode
    --copilot      GitHub Copilot (VS Code)
    --antigravity  Google Antigravity
    --openclaw     OpenClaw

  Options:
    --resume <id>      Resume a previous claude / codex session
    --update           Force update to latest version
    --auto-update      Enable auto-update on every launch (default)
    --no-auto-update   Disable auto-update (shows notice instead)
    --version, -v      Show version
    --help, -h, ?      Show this help

  Examples:
    graperoot                          # interactive picker in current dir
    graperoot .                        # interactive picker in current dir
    graperoot . --claude               # launch Claude Code directly
    graperoot /my/project --cursor
    graperoot /my/project --gemini
    graperoot /my/project --opencode
    graperoot /my/project --copilot
    graperoot /my/project --antigravity
    graperoot /my/project --openclaw
    graperoot /my/project --claude --resume <session-id>
    dgc .                              # same as graperoot . --claude
    dg  .                              # same as graperoot . --codex

HELP
  exit 0
}

# ── Self-update (--update flag) ───────────────────────────────────────────────
_force_update() {
  local _R2="https://pub-18426978d5a14bf4a60ddedd7d5b6dab.r2.dev"
  local _BASE_URL="https://raw.githubusercontent.com/kunal12203/Codex-CLI-Compact/main"
  local _LOCAL_VER
  _LOCAL_VER="$(cat "$SCRIPT_DIR/version.txt" 2>/dev/null || echo "0")"
  local _REMOTE_VER
  _REMOTE_VER="$(curl -sf --max-time 5 "$_BASE_URL/bin/version.txt" 2>/dev/null \
    || curl -sf --max-time 5 "$_R2/version.txt" 2>/dev/null || echo "")"

  if [[ -z "$_REMOTE_VER" ]]; then
    echo "[graperoot] ERROR: could not reach update server."
    exit 1
  fi

  echo "[graperoot] Local version : $_LOCAL_VER"
  echo "[graperoot] Remote version: $_REMOTE_VER"
  echo "[graperoot] Downloading latest launcher files..."

  curl -fsSL --max-time 30 "$_BASE_URL/bin/dual_graph_launch.sh" -o "$SCRIPT_DIR/dual_graph_launch.sh" \
    || curl -fsSL --max-time 30 "$_R2/dual_graph_launch.sh" -o "$SCRIPT_DIR/dual_graph_launch.sh"
  chmod +x "$SCRIPT_DIR/dual_graph_launch.sh"

  curl -fsSL --max-time 15 "$_BASE_URL/bin/graperoot" -o "$SCRIPT_DIR/graperoot" 2>/dev/null \
    && chmod +x "$SCRIPT_DIR/graperoot" || true
  curl -fsSL --max-time 15 "$_BASE_URL/bin/graperoot.cmd" -o "$SCRIPT_DIR/graperoot.cmd" 2>/dev/null || true
  curl -fsSL --max-time 15 "$_BASE_URL/bin/graperoot.ps1" -o "$SCRIPT_DIR/graperoot.ps1" 2>/dev/null || true
  curl -fsSL --max-time 15 "$_BASE_URL/bin/dgc.ps1" -o "$SCRIPT_DIR/dgc.ps1" 2>/dev/null || true
  curl -fsSL --max-time 15 "$_BASE_URL/bin/dg.ps1" -o "$SCRIPT_DIR/dg.ps1" 2>/dev/null || true

  echo "$_REMOTE_VER" > "$SCRIPT_DIR/version.txt"

  # Upgrade graperoot Python package
  local _VENV_PIP="$SCRIPT_DIR/venv/bin/pip"
  if [[ -x "$_VENV_PIP" ]]; then
    echo "[graperoot] Upgrading graperoot Python package..."
    "$_VENV_PIP" install graperoot --upgrade --quiet 2>/dev/null || true
  fi

  echo "[graperoot] Updated to $_REMOTE_VER."
  exit 0
}

# ── Interactive tool picker ───────────────────────────────────────────────────
_interactive_picker() {
  local project_dir="$1"

  echo ""
  echo "  graperoot — Dual-Graph AI tool launcher"
  echo ""
  printf "  Working directory: \033[1m%s\033[0m\n" "$project_dir"
  printf "  Continue? [Y/n]: "
  local confirm=""
  read -r -t 30 confirm 2>/dev/null || confirm=""
  if [[ "$confirm" =~ ^[Nn] ]]; then
    echo "  Cancelled."
    exit 0
  fi
  echo ""

  local tool_keys tool_labels num_tools selected
  tool_keys=("claude" "codex" "cursor" "gemini" "opencode" "copilot" "antigravity" "openclaw" "kilocode" "mimocode")
  tool_labels=("Claude Code" "OpenAI Codex" "Cursor" "Gemini CLI" "OpenCode" "GitHub Copilot" "Antigravity" "OpenClaw" "Kilocode" "MiMo Code")
  num_tools=${#tool_keys[@]}
  selected=0

  _draw_menu() {
    local sel=$1
    local i
    for (( i=0; i<num_tools; i++ )); do
      if (( i == sel )); then
        printf "  \033[36m> %s\033[0m\n" "${tool_labels[$i]}"
      else
        printf "    %s\n" "${tool_labels[$i]}"
      fi
    done
  }

  echo "  Select tool (arrow keys to navigate, Enter to select):"
  echo ""
  _draw_menu $selected

  # Hide cursor
  printf "\033[?25l"
  # Restore cursor on exit/interrupt
  trap 'printf "\033[?25h"' EXIT INT TERM

  # Read arrow keys (bash 3.2 compatible — no fractional -t)
  while true; do
    local key=""
    IFS= read -rsn1 key
    if [[ "$key" == $'\x1b' ]]; then
      local seq=""
      read -rsn2 -t 1 seq || true
      case "$seq" in
        "[A") # Up
          (( selected > 0 )) && (( selected-- )) || true
          ;;
        "[B") # Down
          (( selected < num_tools - 1 )) && (( selected++ )) || true
          ;;
      esac
      # Redraw: move cursor up num_tools lines
      printf "\033[%dA" "$num_tools"
      _draw_menu $selected
    elif [[ "$key" == "" ]]; then
      # Enter pressed
      break
    fi
  done

  # Show cursor
  printf "\033[?25h"
  trap - EXIT INT TERM
  echo ""
  echo "  Launching ${tool_labels[$selected]}..."
  echo ""

  ASSISTANT="${tool_keys[$selected]}"
}

# ── Auto-update preference ────────────────────────────────────────────────────
_set_auto_update() {
  rm -f "$SCRIPT_DIR/no_auto_update" 2>/dev/null || true
  echo "[graperoot] Auto-update enabled. GrapeRoot will update on every launch."
  exit 0
}
_set_no_auto_update() {
  touch "$SCRIPT_DIR/no_auto_update" 2>/dev/null || true
  echo "[graperoot] Auto-update disabled. Run 'graperoot --update' to update manually."
  exit 0
}

# ── Parse arguments ───────────────────────────────────────────────────────────
for _a in "$@"; do
  case "$_a" in
    --help|-h|\?) _show_help ;;
    --version|-v) _show_version ;;
    --update) _force_update ;;
    --auto-update) _set_auto_update ;;
    --no-auto-update) _set_no_auto_update ;;
  esac
done

ASSISTANT="claude"   # default (overridden by picker or flag)
PROJECT=""
PASSTHROUGH=()

_VALID_TOOLS="claude codex cursor gemini opencode copilot antigravity openclaw kilocode mimocode"
_TOOL_SET=false

ARGS=("$@")
i=0
while (( i < ${#ARGS[@]} )); do
  arg="${ARGS[$i]}"
  case "$arg" in
    --claude|claude)            ASSISTANT="claude";      _TOOL_SET=true ;;
    --codex|codex)             ASSISTANT="codex";       _TOOL_SET=true ;;
    --cursor|cursor)           ASSISTANT="cursor";      _TOOL_SET=true ;;
    --gemini|gemini)           ASSISTANT="gemini";      _TOOL_SET=true ;;
    --opencode|opencode)       ASSISTANT="opencode";    _TOOL_SET=true ;;
    --copilot|copilot)         ASSISTANT="copilot";     _TOOL_SET=true ;;
    --antigravity|antigravity) ASSISTANT="antigravity"; _TOOL_SET=true ;;
    --openclaw|openclaw)       ASSISTANT="openclaw";    _TOOL_SET=true ;;
    --kilocode|kilocode)       ASSISTANT="kilocode";    _TOOL_SET=true ;;
    --mimocode|mimocode)       ASSISTANT="mimocode";    _TOOL_SET=true ;;
    --toolname)
      PASSTHROUGH+=("$arg")
      if (( i + 1 < ${#ARGS[@]} )) && [[ "${ARGS[$((i + 1))]}" != --* ]]; then
        i=$((i + 1))
        PASSTHROUGH+=("${ARGS[$i]}")
      fi
      ;;
    --toolname=*)
      PASSTHROUGH+=("$arg")
      ;;
    *)
      # First non-flag positional arg is the project path
      if [[ -z "$PROJECT" && "$arg" != --* ]]; then
        PROJECT="$arg"
      else
        PASSTHROUGH+=("$arg")
      fi
      ;;
  esac
  i=$((i + 1))
done

# Catch typos like --claud, --gemi, --curs — check if any passthrough arg looks
# like a misspelled tool flag (starts with -- and is not a known claude CLI flag)
if ! $_TOOL_SET; then
  for _pt in "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"; do
    _bare="${_pt#--}"
    if [[ "$_pt" == --* && "$_bare" != *=* ]]; then
      # Check if it's close to a valid tool name (prefix match)
      for _t in $_VALID_TOOLS; do
        if [[ "$_t" == "$_bare"* || "$_bare" == "$_t"* ]]; then
          echo "[graperoot] Unknown tool '--$_bare'. Did you mean '--$_t'?" >&2
          echo "[graperoot] Valid tools: $_VALID_TOOLS" >&2
          exit 2
        fi
      done
    fi
  done
fi

[[ -z "$PROJECT" ]] && PROJECT="$(pwd)"

# ── Interactive picker when no tool flag given and stdin is a terminal ─────────
if ! $_TOOL_SET && [[ -t 0 ]] && [[ -t 1 ]]; then
  _interactive_picker "$PROJECT"
fi

exec "$SCRIPT_DIR/dual_graph_launch.sh" "$ASSISTANT" "$PROJECT" --toolname graperoot \
  "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"
